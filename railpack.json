{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "steps": {
    "playwright": {
      "inputs": [{ "step": "install" }],
      "commands": ["mise exec -- python3 -m playwright install --with-deps chromium"]
    }
  },
  "deploy": {
    "inputs": [{ "step": "playwright" }],
    "startCommand": "mise exec -- python3 boxboxai_bot.py"
  }
}
